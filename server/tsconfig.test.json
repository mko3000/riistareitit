{
  // RII-36: type-checks tests (and, since RII-47, hand-run scripts) alongside
  // the source — Vitest and tsx don't type-check. The build (tsconfig.json)
  // still compiles src/ only.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // vitest.config.ts imports a .ts file directly (Vite's config loader wants
    // the real extension); fine since nothing here is emitted.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
