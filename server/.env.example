# Copy to .env for local development. Matches the credentials in the
# root docker-compose.yml `postgres` service — change both together.
# Host port is 5433, not Postgres's usual 5432 — some dev machines already
# run a native Postgres on 5432, and the container avoids colliding with it.
DATABASE_URL="postgresql://riistareitit:riistareitit@localhost:5433/riistareitit"

# Port the API listens on.
PORT=3001

# Origin the Vite dev server runs on, for CORS.
WEB_ORIGIN="http://localhost:5173"
