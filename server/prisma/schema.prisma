// Prisma schema for the riistareitit backend.
// See docs/SPEC.md §4 for the full data model this will grow into.
//
// RII-27 shipped this file with zero models (plumbing only). RII-28 adds
// the first real table, `users`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RII-28. `role` is unused until RII-9 (admin role) — always "member" for now.
//
// Case-insensitive email uniqueness (per RII-28's acceptance criteria) is
// enforced at the application layer, not here: callers (RII-29 sign-up,
// RII-30 login) MUST lowercase `email` before every write and every lookup.
// The `@unique` below is a case-*sensitive* DB-level backstop against exact
// duplicates — it does not by itself stop "a@b.com" and "A@b.com" coexisting
// if a caller forgets to normalize. Chose this over Postgres's `citext`
// extension to avoid an extra Prisma preview feature for a one-column need.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  role         String   @default("member")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  sessions Session[]

  @@map("users")
}

// RII-29. Not itself a RII-29 acceptance criterion, but RII-29 needs it: "on
// success, the user is signed in immediately" requires a session mechanism,
// which was otherwise scoped to RII-30. Built the shared piece here (create +
// cookie helpers); RII-30 adds the login/logout/me *endpoints* on top of the
// same module (server/src/session.ts) rather than re-inventing it — see that
// ticket for the updated split.
//
// Server-side session, not a stateless signed cookie: the cookie only holds
// this row's id, so logout (RII-30) can delete the row for real revocation,
// per that ticket's "invalidates server-side, not just client state"
// requirement.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([userId])
  @@map("sessions")
}
