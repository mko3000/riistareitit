// Prisma schema for the riistareitit backend.
// See docs/SPEC.md §4 for the full data model this will grow into.
//
// RII-27 shipped this file with zero models (plumbing only). RII-28 adds
// the first real table, `users`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RII-28. `role` is unused until RII-9 (admin role) — always "member" for now.
//
// Case-insensitive email uniqueness (per RII-28's acceptance criteria) is
// enforced at the application layer, not here: callers (RII-29 sign-up,
// RII-30 login) MUST lowercase `email` before every write and every lookup.
// The `@unique` below is a case-*sensitive* DB-level backstop against exact
// duplicates — it does not by itself stop "a@b.com" and "A@b.com" coexisting
// if a caller forgets to normalize. Chose this over Postgres's `citext`
// extension to avoid an extra Prisma preview feature for a one-column need.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  role         String   @default("member")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  sessions  Session[]
  sightings Sighting[]
  tracks    Track[]

  @@map("users")
}

// RII-29. Not itself a RII-29 acceptance criterion, but RII-29 needs it: "on
// success, the user is signed in immediately" requires a session mechanism,
// which was otherwise scoped to RII-30. Built the shared piece here (create +
// cookie helpers); RII-30 adds the login/logout/me *endpoints* on top of the
// same module (server/src/session.ts) rather than re-inventing it — see that
// ticket for the updated split.
//
// Server-side session, not a stateless signed cookie: the cookie only holds
// this row's id, so logout (RII-30) can delete the row for real revocation,
// per that ticket's "invalidates server-side, not just client state"
// requirement.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([userId])
  @@map("sessions")
}

// RII-20. Preset bird species for the sighting/kill species picker (RII-22).
// `nameEn` stays null until RII-14 (English toggle) fills it in.
model Species {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key      String  @unique
  nameFi   String  @map("name_fi")
  nameEn   String? @map("name_en")
  icon     String
  isPreset Boolean @default(true) @map("is_preset")

  sightings Sighting[]

  @@map("species")
}

// RII-20. See docs/SPEC.md §4's notes on this table for the reasoning behind
// splitting `personDisplay` (free text — who actually saw/killed it, may not
// be a user at all) from `createdByUserId` (who was logged in when the row
// was added; independent of personDisplay; ON DELETE SET NULL so deleting an
// account never deletes the sighting itself).
//
// Editing/deleting is deliberately unrestricted for now (RII-23) — anyone
// can edit/delete any row. `createdByUserId` exists so that can be locked
// down later without a schema change. Visibility is also unrestricted for
// now (RII-22's GET /sightings returns everything to everyone) — see RII-33
// for the not-yet-resolved party-scoped privacy design this needs before
// real (non-testing) use.
model Sighting {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lat             Float
  lng             Float
  speciesId       String?   @map("species_id") @db.Uuid
  species         Species?  @relation(fields: [speciesId], references: [id])
  customSpecies   String?   @map("custom_species")
  kind            String    @default("sighting") // "sighting" | "kill"
  notes           String?
  personDisplay   String    @default("unknown") @map("person_display")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdBy       User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  observedDate    DateTime  @map("observed_date") @db.Date
  observedTime    DateTime? @map("observed_time") @db.Time
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([observedDate])
  @@map("sightings")
}

// RII-3. Imported walking routes (parsed client-side from TCX/GPX/KML, see
// docs/SPEC.md §5). The original file is never stored — only the points, all
// of them in `segments` as one JSONB value (format and reasoning: SPEC.md §4
// "Track geometry storage"). Import requires login, so ownerUserId is always
// set on create; nullable + SET NULL mirrors sightings until RII-33 decides
// what happens to a deleted account's tracks. Visibility is global for
// logged-in users for now (RII-33).
model Track {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  sourceFormat String    @map("source_format") // "tcx" | "gpx" | "kml" | "json"
  ownerUserId  String?   @map("owner_user_id") @db.Uuid
  owner        User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  importedAt   DateTime  @default(now()) @map("imported_at") @db.Timestamptz
  recordedDate DateTime? @map("recorded_date") @db.Date
  segments     Json      @db.JsonB

  @@map("tracks")
}
